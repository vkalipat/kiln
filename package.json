{
  "name": "kiln",
  "version": "0.1.2",
  "description": "A terminal harness for research, ideation, and implementation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkalipat/kiln.git"
  },
  "homepage": "https://vkalipat.github.io/kiln/",
  "bugs": {
    "url": "https://github.com/vkalipat/kiln/issues"
  },
  "private": true,
  "type": "module",
  "bin": {
    "kiln": "./bin/kiln.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:usecases": "bun test test/usecases",
    "typecheck": "bunx tsc --noEmit",
    "docs:check": "bun scripts/check-docs.ts",
    "kiln": "bun run bin/kiln.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "18.6.1",
    "@oh-my-pi/pi-ai": "18.6.1",
