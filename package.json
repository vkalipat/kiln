    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@oh-my-pi/pi-tui": "18.6.1",
    "@oh-my-pi/pi-utils": "18.6.1",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-ai@18.6.1": "patches/@oh-my-pi%2Fpi-ai@18.6.1.patch",
    "@oh-my-pi/pi-coding-agent@18.6.1": "patches/@oh-my-pi%2Fpi-coding-agent@18.6.1.patch"
  }
